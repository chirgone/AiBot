{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentica-voice",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "agentica.angaflow.mx",
      "custom_domain": true
    },
    {
      "pattern": "help.angaflow.mx",
      "custom_domain": true
    },
    {
      "pattern": "admin.angaflow.mx",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentica",
      "database_id": "14703346-abde-4669-9e85-a238905d8af2",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VOICE_AGENT",
        "class_name": "VoiceAgent"
      }
    ]
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "agentica-knowledge"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoiceAgent"]
    }
  ],
  "vars": {
    "ASSISTANT_NAME": "Asistente AngaFlow",
    "BUSINESS_NAME": "AngaFlow",
    "LANGUAGE": "es-MX",
    "VOICE": "Polly.Mia-Neural",
    "TIME_ZONE": "America/Mexico_City",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "SKIP_SIGNATURE_VALIDATION": "false",
    "MAX_TURNS_PER_CALL": "12",
    "MIN_SPEECH_CONFIDENCE": "0.4",
    "RAG_ENABLED": "true"
  }
}
